# Subscription confirmations use the transactional stream; project-note editions use the bulk stream.
# No account secrets are shipped here. Use local environment values when running the app.
# Email setup: docs/email-setup.md. For a local preview without credentials, use MAIL_MODE=log with npm run dev.

APP_URL=http://localhost:3000 # Base origin for confirmation and unsubscribe URLs; use your real site address when deployed.
HOST=127.0.0.1 # Where the server listens; this loopback value does not expose it to other machines.
PORT=3000 # Port used by npm start. Adjust the dev-server configuration separately.
DB_PATH=.data/app.sqlite # Subscription consent, confirmation tokens, and verification emails; SQLite file relative to the app directory. Preserve it across deployments.
ADMIN_PASSWORD= # Use a unique random password, at least 16 characters, for admin to inspect subscription status.
OWNER_EMAIL=owner@example.com # Not used for subscription confirmation links; this setting can be left empty.
REVIEWER_EMAIL=reviewer@example.com # This app does not send subscription confirmation links to a separate reviewer; the value is unused.
MAIL_MODE=sandbox # Select sandbox, production, or development-only log for subscription confirmation links.
MAIL_FROM=sender@example.com # From address on subscription confirmation links; use your verified Mailtrap sending domain in production.
MAILTRAP_PRODUCTION_TOKEN= # Production credential for subscription confirmation links; obtain a transactional sending token from your Mailtrap account.
MAILTRAP_SANDBOX_TOKEN= # API token with access to the Sandbox used for newsletter opt in messages.
MAILTRAP_INBOX_ID= # Numeric Sandbox ID from its API integration settings; captured subscriber email stays here.
NEWSLETTER_POSTAL_ADDRESS= # Your organization’s mailing address, included below every project-note edition.
