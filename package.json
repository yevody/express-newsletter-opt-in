    "test": "node --test test/*.test.mjs",
    "retry-email": "node --env-file-if-exists=.env scripts/retry-email.mjs"
  },
  "dependencies": {
    "express": "5.2.1",
    "ejs": "^3.1.10",
    "zod": "^4.1.0"
  },
